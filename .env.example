# Copy to .env and fill in. Shared by backend (API + agent) and frontend tooling.

# ── API ─────────────────────────────────────────────────────
PORT=3010
API_URL=http://127.0.0.1:3010
# Shared secret the agent uses to post call events to the API (any long random string)
INTERNAL_API_SECRET=change-me-to-a-long-random-string
# Set in production: NODE_ENV=production (enables CPU-based call shedding in the agent)
# NODE_ENV=production
# Only when the frontend is served from a different origin than the API
# CORS_ORIGIN=https://demo.example.com

# ── LiveKit ─────────────────────────────────────────────────
# Local dev server (npm run dev) uses devkey / secret
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
AGENT_NAME=lemans-receptionist
# AGENT_LOAD_THRESHOLD=0.7

# ── Voice pipeline ──────────────────────────────────────────
# cascade  = Deepgram STT → OpenAI LLM → ElevenLabs TTS (ElevenLabs voice)
# realtime = OpenAI speech-to-speech gpt-realtime-2.1 (faster, OpenAI voice)
# live     = OpenAI GPT-Live full-duplex voice + a backend model that runs the tools
AGENT_PIPELINE=cascade

OPENAI_API_KEY=sk-...
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_LIVE_VOICE=marin

# Used when AGENT_PIPELINE=live (needs a paid OpenAI tier)
GPT_LIVE_MODEL=gpt-live-1
GPT_LIVE_VOICE=marin
# Backend model for delegated work (tools). Empty = OpenAI's default (gpt-5.6-luna).
# GPT_LIVE_BACKEND_MODEL=
# none | minimal | low | medium | high — higher thinks longer before a tool runs
GPT_LIVE_BACKEND_REASONING=low

DEEPGRAM_API_KEY=...
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-AU

ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── Data ────────────────────────────────────────────────────
# Optional: without it calls and leads are kept in memory only
MONGO_URI=mongodb+srv://user:pass@cluster/...
MONGO_DB=lemans_voice
TIMEZONE=Australia/Melbourne

# ── Phone transfers (phase 2) ───────────────────────────────
# Numbers the agent transfers phone callers to. Unset = take a callback lead instead.
# Never set these to the main line the agent answers (it would loop back to the agent).
# TRANSFER_RESERVATIONS=03XXXXXXXX
# TRANSFER_CORPORATE=04XXXXXXXX
# TRANSFER_DUTY_MANAGER=04XXXXXXXX

# ── Phone calls (PBX → this machine), dev only ─────────────────
# true = `npm run dev` also starts LiveKit SIP in Docker (needs Docker Desktop running)
SIP_ENABLED=false
SIP_PORT=5100
SIP_RTP_PORTS=10000-10100
# Only accept calls from the PBX (comma separated IPs). Empty = any address
SIP_ALLOWED_ADDRESSES=
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
# Empty = detect automatically
SIP_PUBLIC_IP=
